# ============================================================
# ProcessScope .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/output/
build/
sdist/
wheels/
*.whl
.eggs/

# Virtual environment
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js / Web Dashboard
web/node_modules/
web/dist/
web/.vite/
web/*.local

# Packaging output
dist/output/
*.tar.gz
*.deb
*.rpm
*.pkg

# Environment
.env
.env.local
.env.*.local

# Logs (dev only)
*.log

# Database (dev only)
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Build artifacts
/bin/
/output/
